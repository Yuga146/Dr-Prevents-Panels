                // Search Query
                if (searchQuery.trim() !== '') {
                    const query = searchQuery.toLowerCase();
                    const nameMatch = panel.name.toLowerCase().includes(query);
                    const picMatch = panel.pic && panel.pic.toLowerCase().includes(query);
                    const phoneMatch = panel.phone && panel.phone.includes(query);
                    const notesMatch = panel.notes && panel.notes.toLowerCase().includes(query);
                    const branchMatch = panel.branches.some(b => b.toLowerCase().includes(query));
                    if (!nameMatch && !picMatch && !phoneMatch && !notesMatch && !branchMatch) return false;
                }

                return true;
            });
