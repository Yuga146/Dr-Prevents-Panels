                    <!-- Actions -->
                    <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                        <button onclick="deletePanel('${panel.id}')" class="text-xs text-red-600 dark:text-red-400 hover:underline flex items-center space-x-1">
                            <i class="fa-solid fa-trash"></i>
                            <span>Remove Panel</span>
                        </button>
                        ${panel.phone ? `
                            <a href="tel:${panel.phone}" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs flex items-center space-x-2">
                                <i class="fa-solid fa-phone"></i>
                                <span>Call Contact</span>
                            </a>
                        ` : ''}
                    </div>
                </div>
            `;

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function deletePanel(id) {
            if (confirm('Are you sure you want to remove this panel?')) {
                panelsData = panelsData.filter(p => p.id !== id);
                saveData();
                updateStatCounts();
                closeDetailModal();
                render();
            }
        }

        function resetFilters() {
            currentCategory = 'ALL';
            currentBranch = 'ALL';
            searchQuery = '';
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            document.getElementById('branchSelectFilter').value = 'ALL';

            document.querySelectorAll('.tab-btn').forEach(btn => {
                if (btn.dataset.category === 'ALL') {
                    btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-brand-600 text-white shadow-sm';
                } else {
                    btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
                }
            });

            render();
        }

        // Setup DOM Event Listeners
        window.addEventListener('DOMContentLoaded', () => {
            initData();

            // Dark Mode Toggle Logic
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            themeToggleBtn.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                const isDark = document.documentElement.classList.contains('dark');
                localStorage.setItem('drprevents_theme', isDark ? 'dark' : 'light');
            });

            // Restore dark theme preference
            if (localStorage.getItem('drprevents_theme') === 'dark' || (!('drprevents_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }

            // Search Input listener
            const searchInput = document.getElementById('searchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');

            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value;
                if (searchQuery.length > 0) {
                    clearSearchBtn.classList.remove('hidden');
                } else {
                    clearSearchBtn.classList.add('hidden');
                }
                render();
            });

            clearSearchBtn.addEventListener('click', () => {
                searchInput.value = '';
                searchQuery = '';
                clearSearchBtn.classList.add('hidden');
                render();
            });

            document.getElementById('resetFiltersBtn').addEventListener('click', resetFilters);

            // Branch Dropdown Listener
            document.getElementById('branchSelectFilter').addEventListener('change', (e) => {
                currentBranch = e.target.value;
                render();
            });

            // Category Tab Listeners
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-btn').forEach(b => {
                        b.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
                    });
                    btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-brand-600 text-white shadow-sm';
                    currentCategory = btn.dataset.category;
                    render();
                });
            });

            // View Mode Switcher
            const viewListBtn = document.getElementById('viewListBtn');
            const viewGridBtn = document.getElementById('viewGridBtn');
            const listView = document.getElementById('panelListView');
            const matrixView = document.getElementById('panelMatrixView');

            viewListBtn.addEventListener('click', () => {
                currentView = 'list';
                viewListBtn.className = 'px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors bg-white dark:bg-darkCard text-brand-600 dark:text-brand-400 shadow-sm';
                viewGridBtn.className = 'px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
                listView.classList.remove('hidden');
                matrixView.classList.add('hidden');
            });

            viewGridBtn.addEventListener('click', () => {
                currentView = 'grid';
                viewGridBtn.className = 'px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors bg-white dark:bg-darkCard text-brand-600 dark:text-brand-400 shadow-sm';
                viewListBtn.className = 'px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
                matrixView.classList.remove('hidden');
                listView.classList.add('hidden');
            });

            // Modal Trigger Listeners
            const addPanelModal = document.getElementById('addPanelModal');
            document.getElementById('addPanelBtn').addEventListener('click', () => {
                addPanelModal.classList.remove('hidden');
            });

            document.querySelectorAll('.modal-close').forEach(btn => {
                btn.addEventListener('click', () => {
                    addPanelModal.classList.add('hidden');
                    closeDetailModal();
                });
            });

            // Add Panel Form Submit
            document.getElementById('addPanelForm').addEventListener('submit', (e) => {
                e.preventDefault();
                
                const selectedBranches = Array.from(document.querySelectorAll('input[name="branchCheckbox"]:checked')).map(cb => cb.value);

                if (selectedBranches.length === 0) {
                    alert('Please select at least one branch for this panel.');
                    return;
                }

                const newPanel = {
                    id: Date.now().toString(),
                    name: document.getElementById('panelNameInput').value.trim(),
                    category: document.getElementById('panelCategoryInput').value,
                    status: document.getElementById('panelStatusInput').value,
                    pic: document.getElementById('panelPicInput').value.trim(),
                    phone: document.getElementById('panelPhoneInput').value.trim(),
                    branches: selectedBranches,
                    notes: document.getElementById('panelNotesInput').value.trim()
                };

                panelsData.unshift(newPanel);
                saveData();
                updateStatCounts();
                render();

                // Reset and close
                document.getElementById('addPanelForm').reset();
                addPanelModal.classList.add('hidden');
            });
        });
    </script>
</body>
</html>
