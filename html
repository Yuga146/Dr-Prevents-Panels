
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DrPrevents - Clinic Panel & Branch Directory</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        },
                        cyanBrand: {
                            400: '#22d3ee',
                            500: '#06b6d4',
                            600: '#0891b2',
                        },
                        darkBg: '#0f172a',
                        darkCard: '#1e293b',
                        darkBorder: '#334155'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
        }
        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(12px);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-darkBg dark:text-slate-100 min-h-full flex flex-col transition-colors duration-200">

    <!-- Top Header Navigation -->
    <header class="sticky top-0 z-30 bg-white/90 dark:bg-darkCard/90 backdrop-blur-md border-b border-slate-200 dark:border-darkBorder shadow-sm transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Logo & Brand -->
            <div class="flex items-center space-x-3">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-700 via-brand-600 to-cyanBrand-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                    <i class="fa-solid fa-stethoscope text-2xl"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-brand-700 via-brand-600 to-cyanBrand-600 dark:from-blue-400 dark:to-cyanBrand-400 bg-clip-text text-transparent">DrPrevents</span>
                        <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-brand-100 text-brand-800 dark:bg-brand-900/60 dark:text-brand-300">CLINIC NETWORK</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Panel Directory & Branch Management System</p>
                </div>
            </div>

            <!-- Actions & Controls -->
            <div class="flex items-center space-x-3">
                <button id="addPanelBtn" class="flex items-center space-x-2 bg-gradient-to-r from-brand-600 to-cyanBrand-600 hover:from-brand-700 hover:to-cyanBrand-700 text-white font-medium text-sm px-4 py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span class="hidden sm:inline">Add New Panel</span>
                </button>

                <!-- Theme Toggle Button -->
                <button id="themeToggleBtn" aria-label="Toggle theme" class="p-2.5 rounded-xl border border-slate-200 dark:border-darkBorder bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    <i class="fa-solid fa-moon text-base dark:hidden"></i>
                    <i class="fa-solid fa-sun text-base hidden dark:block text-amber-400"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Top Summary Cards (No branch overlap) -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
            <!-- Total Panels -->
            <div class="bg-white dark:bg-darkCard p-5 rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-20 h-20 bg-brand-500/10 dark:bg-brand-500/20 rounded-full blur-xl group-hover:scale-150 transition-transform"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">Total Panels</p>
                        <h3 id="statTotal" class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">52</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-building-user"></i>
                    </div>
                </div>
            </div>

            <!-- TPAs & Insurance -->
            <div class="bg-white dark:bg-darkCard p-5 rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-20 h-20 bg-cyanBrand-500/10 dark:bg-cyanBrand-500/20 rounded-full blur-xl group-hover:scale-150 transition-transform"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">TPAs / Insurance</p>
                        <h3 id="statTpa" class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">20</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-cyan-50 dark:bg-cyan-900/40 text-cyanBrand-500 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                </div>
            </div>

            <!-- Corporate Direct -->
            <div class="bg-white dark:bg-darkCard p-5 rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-20 h-20 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-full blur-xl group-hover:scale-150 transition-transform"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">Corporate Direct</p>
                        <h3 id="statCorporate" class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">28</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                </div>
            </div>

            <!-- Government Schemes -->
            <div class="bg-white dark:bg-darkCard p-5 rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-20 h-20 bg-sky-500/10 dark:bg-sky-500/20 rounded-full blur-xl group-hover:scale-150 transition-transform"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">Govt / Schemes</p>
                        <h3 id="statGovt" class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">4</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-sky-50 dark:bg-sky-900/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-landmark"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- Search & Dynamic Filter Controls -->
        <section class="bg-white dark:bg-darkCard p-5 rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm space-y-4">
            <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
                
                <!-- Search Box -->
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="searchInput" placeholder="Search by panel name, corporate direct brand, PIC, or phone..." class="w-full pl-11 pr-10 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all text-slate-800 dark:text-slate-100 placeholder-slate-400">
                    <button id="clearSearchBtn" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Filters & Controls Container -->
                <div class="flex flex-wrap items-center gap-3">
                    
                    <!-- Branch Filter Dropdown -->
                    <div class="relative flex-1 sm:flex-none">
                        <select id="branchSelectFilter" class="w-full sm:w-auto px-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-brand-500 text-slate-700 dark:text-slate-200">
                            <option value="ALL">All Branches (10)</option>
                            <option value="KP">KP - Kepong</option>
                            <option value="SD">SD - Bandar Sri Damansara</option>
                            <option value="ST">ST - Seri Tenteram</option>
                            <option value="JI">JI - Jalil Link</option>
                            <option value="DJ">DJ - Damansara Jaya</option>
                            <option value="SS15">SS15 - Subang Jaya</option>
                            <option value="PJOT">PJOT - Old Town PJ</option>
                            <option value="BPP">BPP - Bandar Putra Permai</option>
                            <option value="KK">KK - Kota Kemuning</option>
                            <option value="TAIPAN">TAIPAN - USJ Taipan</option>
                        </select>
                    </div>

                    <!-- Layout View Switcher -->
                    <div class="flex bg-slate-100 dark:bg-slate-900 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
                        <button id="viewListBtn" class="px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors bg-white dark:bg-darkCard text-brand-600 dark:text-brand-400 shadow-sm">
                            <i class="fa-solid fa-list"></i>
                            <span>List View</span>
                        </button>
                        <button id="viewGridBtn" class="px-3 py-2 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                            <i class="fa-solid fa-border-all"></i>
                            <span>Branch Matrix</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex items-center space-x-2 border-t border-slate-100 dark:border-slate-800 pt-4 overflow-x-auto no-scrollbar">
                <button data-category="ALL" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-brand-600 text-white shadow-sm">
                    All Categories
                </button>
                <button data-category="TPA" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700">
                    TPA / Insurance
                </button>
                <button data-category="CORPORATE" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700">
                    Corporate Direct
                </button>
                <button data-category="GOVERNMENT" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700">
                    Government / Schemes
                </button>
            </div>
        </section>

        <!-- Active Search / Filter Indicator -->
        <div id="filterStatus" class="hidden flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 px-1">
            <span>Showing filtered results for: <strong id="filterStatusText" class="text-brand-600 dark:text-brand-400"></strong></span>
            <button id="resetFiltersBtn" class="text-brand-600 dark:text-brand-400 hover:underline font-semibold">Reset all filters</button>
        </div>

        <!-- ListView Container -->
        <div id="panelListView" class="space-y-4">
            <!-- Panels list injected here dynamically -->
        </div>

        <!-- Matrix View Container (Hidden by default) -->
        <div id="panelMatrixView" class="hidden bg-white dark:bg-darkCard rounded-2xl border border-slate-200/80 dark:border-darkBorder shadow-sm overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-slate-100 dark:bg-slate-900/80 border-b border-slate-200 dark:border-darkBorder font-bold text-slate-700 dark:text-slate-300">
                        <th class="p-4 sticky left-0 bg-slate-100 dark:bg-slate-900 z-10 min-w-[200px]">Panel Name</th>
                        <th class="p-4">Type</th>
                        <th class="p-2 text-center">KP</th>
                        <th class="p-2 text-center">SD</th>
                        <th class="p-2 text-center">ST</th>
                        <th class="p-2 text-center">JI</th>
                        <th class="p-2 text-center">DJ</th>
                        <th class="p-2 text-center">SS15</th>
                        <th class="p-2 text-center">PJOT</th>
                        <th class="p-2 text-center">BPP</th>
                        <th class="p-2 text-center">KK</th>
                        <th class="p-2 text-center">TAIPAN</th>
                    </tr>
                </thead>
                <tbody id="matrixTableBody" class="divide-y divide-slate-100 dark:divide-slate-800">
                    <!-- Matrix rows generated dynamically -->
                </tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden bg-white dark:bg-darkCard p-12 rounded-2xl border border-slate-200/80 dark:border-darkBorder text-center space-y-4">
            <div class="w-16 h-16 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <h4 class="text-base font-bold text-slate-800 dark:text-white">No Matching Panels Found</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">Try adjusting your search terms, changing the branch selection, or clearing selected filter tabs.</p>
            <button onclick="resetFilters()" class="px-4 py-2 bg-brand-600 text-white text-xs font-medium rounded-xl hover:bg-brand-700 transition-colors">Clear All Filters</button>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-darkBorder bg-white/50 dark:bg-darkCard/50 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 dark:text-slate-400 space-y-1">
            <p>© 2026 DrPrevents Medical Group. Clinic Panel Management Directory.</p>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">Includes all 10 branches: KP, SD, ST, JI, DJ, SS15, PJOT, BPP, KK, TAIPAN.</p>
        </div>
    </footer>

    <!-- ADD PANEL MODAL -->
    <div id="addPanelModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden transform transition-all">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-200 dark:border-darkBorder flex items-center justify-between bg-slate-50 dark:bg-slate-900/50">
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center space-x-2">
                    <i class="fa-solid fa-plus-circle text-brand-600 dark:text-brand-400"></i>
                    <span>Add New Panel</span>
                </h3>
                <button class="modal-close text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="addPanelForm" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Panel / Company Name *</label>
                    <input type="text" id="panelNameInput" required placeholder="e.g. Acme Health TPA" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Category *</label>
                        <select id="panelCategoryInput" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white">
                            <option value="TPA">TPA / Insurance</option>
                            <option value="CORPORATE">Corporate Direct</option>
                            <option value="GOVERNMENT">Government / Scheme</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Status</label>
                        <select id="panelStatusInput" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white">
                            <option value="Active">Active</option>
                            <option value="Pending">Pending Setup</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Contact Person / PIC Name</label>
                    <input type="text" id="panelPicInput" placeholder="e.g. Mr. John Doe" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Contact Phone Number</label>
                    <input type="text" id="panelPhoneInput" placeholder="e.g. +6012-3456789" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white">
                </div>

                <!-- Branch Checkboxes -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">Available Branches (Select All Applicable)</label>
                    <div class="grid grid-cols-5 gap-2 p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="KP" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>KP</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="SD" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>SD</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="ST" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>ST</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="JI" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>JI</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="DJ" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>DJ</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="SS15" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>SS15</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="PJOT" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>PJOT</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="BPP" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>BPP</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="KK" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>KK</span>
                        </label>
                        <label class="flex items-center space-x-1.5 text-xs text-slate-700 dark:text-slate-300 cursor-pointer">
                            <input type="checkbox" name="branchCheckbox" value="TAIPAN" checked class="rounded text-brand-600 focus:ring-brand-500">
                            <span>TAIPAN</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Additional Remarks / Notes</label>
                    <textarea id="panelNotesInput" rows="2" placeholder="e.g. Pre-approval required for Specialist referral" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none dark:text-white"></textarea>
                </div>

                <div class="pt-2 flex items-center justify-end space-x-3">
                    <button type="button" class="modal-close px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 text-white text-xs font-semibold hover:bg-brand-700 shadow-md transition-all">Save Panel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- PANEL DETAILS MODAL -->
